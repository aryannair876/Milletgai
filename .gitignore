# ============================================
# MilletsGAI .gitignore
# ============================================

# ----- Model Weights (LARGE FILES) -----
# Base Llama 3 8B model (~16GB)
Meta-Llama-3-8B-Instruct/

# Fine-tuned LoRA adapters & checkpoints (~1.6GB)
models/

# ----- Generated Data -----
# ChromaDB vector database (~100MB, regenerated by ingest_data.py)
chroma_db/

# Evaluation outputs (regenerated by eval scripts)
*.csv
*_report.md
evaluation_3way_report.md
nlp_metrics_report.md

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# ----- Node.js / Frontend -----
frontend/node_modules/
frontend/.next/
frontend/out/

# ----- IDE & Editor -----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# ----- OS Files -----
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# ----- Misc -----
*.log
*.tmp
*.bak
.env
.env.local
.env.*.local
