# ============================================
# MilletsGAI .gitignore
# ============================================

# ----- Model Weights (LARGE FILES) -----
# Base Llama 3 8B model (~16GB)
Meta-Llama-3-8B-Instruct/

# Fine-tuned LoRA adapters & checkpoints (~1.6GB)
models/

# ----- Generated Data -----
# ChromaDB vector database (~100MB, regenerated by ingest_data.py)
chroma_db/

# Evaluation outputs (regenerated by eval scripts)
*.csv
*_report.md
evaluation_3way_report.md
nlp_metrics_report.md

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# ----- Node.js / Frontend -----
frontend/node_modules/
frontend/.next/
frontend/out/

# ----- IDE & Editor -----
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# ----- OS Files -----
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# ----- Misc -----
*.log
*.tmp
*.bak
.env
.env.local
.env.*.local

# ----- Academic / Conference Material -----
# Paper drafts, camera-ready files, reviewer responses, slide decks.
# These live outside the repo (see ../milletai-paper/) and must never be committed.
*.docx
*.pptx
*.pdf
paper-archive/
_deck_preview*/
_paper_media/
_v2_media/

# Scratch scripts & text dumps from paper/deck authoring
_*.py
_*.txt
build_deck.py
!__init__.py

# ----- Agent / Tooling Config -----
.kilo/
.claude/
